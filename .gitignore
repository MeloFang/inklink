# === 词库资源（见 ADR-0003） ===
# 除下面两个例外文件外都不入库。
data/*
!data/upstream/
data/upstream/*
!data/upstream/ice/
data/upstream/ice/*
# 例外：这两份是**构建输入**（GPL-3.0，来源与哈希见 data/manifest.json），必须入库。
# 上游 rime-ice 的 main 会变（2026-11-02 就改过一次），只按 URL 下载会让 CI 打出
# 与本地验证过的完全不同的包。
!data/upstream/ice/base.dict.yaml
!data/upstream/ice/8105.dict.yaml
*.dict.yaml
!data/upstream/ice/*.dict.yaml
base.tsv

# === Rust / Tauri ===
app/target/
app/src-tauri/target/
app/src-tauri/gen/

# === Node ===
app/node_modules/
app/dist/
app/build/
app/.svelte-kit/
app/.vite/
npm-debug.log*

# === Python ===
.venv/
__pycache__/
*.pyc
extractor/terms.json
extractor/.cache/
tmp/

# === 系统 / 编辑器 ===
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

*.bak


# TSF 构建产物
/tsf/target/
/tsf/target-static/

/rime-server/rime.dll
/rime-server/rime/
/rime-server/*.exe
/rime-server/*.obj
/rime-server/*.log
/rime-server/*.out
/rime-server/*.err
/rime-server/*.txt
# 例外：英文补全词表是**构建输入**（4 万词、按词频排序），必须入库 ——
# 让 CI 下载会让打出来的包和本地验证过的不是同一份词表（同 data/upstream/ice 的理由）。
!/rime-server/en-words.txt

# 安装包产物（二进制与 zip 不进 git；脚本与说明保留）
/dist/
# 调试残留（编译日志、临时输出、截图）
/tmp/
*.out
*.err
*.obj
/dist/*.out
/dist/*.err
/dist/*.txt
/tsf/test/*.exe
/tsf/test/*.obj
/app/node_modules/

# 临时提交信息文件（git commit -F 用）
msg.txt

# 本机个人模糊音配置（不进 git，出厂默认在 rime-config/fuzzy.yaml）
/rime-config/fuzzy.local.yaml

# 图标生成的中间预览图
/installer/preview-*.png
# 浮条的构建产物与调试截图
/ui/target/
/ui/shot-*.png
/ui/*.log
# 浮条的本地预览图（`cargo test` 渲的 bar-preview.bmp 放大版）与并排对照图
/ui/bar-preview-*.png
/ui/_compare.png
# 品牌检查用的对照图（不是交付物）
/docs/brand/_probe-*.png

# Kiro 的本地规格目录（spec 文档留作参考，但不入库）
/.kiro/

# 候选窗预览图（`cargo test` 渲的 cand-preview-*.bmp 转出来的 PNG）
/ui/cand-preview-*.png
/ui/bar-compare-dark.png
/ui/badge-dark-x8.png
# 上游二进制与词库（tools\fetch-librime.ps1 会重新下载，不入库）
/vendor/
# 单文件安装器的构建产物
/installer/setup/target/

# 设置窗构建产物
/settings/target/
/ui/settings-*.png
# 部署脚本临时输出
/_deploy.*
